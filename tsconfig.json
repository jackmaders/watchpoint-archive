{
	"compilerOptions": {
		"esModuleInterop": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": { "@/*": ["./src/*"] },
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"types": ["@cloudflare/workers-types"]
	},
	"exclude": ["dist", ".output"],
	"include": ["**/*.ts", "**/*.tsx", "**/*.mts"]
}
