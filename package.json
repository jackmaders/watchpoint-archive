{
	"dependencies": {
		"@radix-ui/react-slot": "^1.3.3",
		"@sentry/react": "^10.70.0",
		"@tanstack/react-query": "^5.102.0",
		"@tanstack/react-router": "^1.170.29",
		"@tanstack/react-router-ssr-query": "^1.167.2",
		"@tanstack/react-start": "^1.168.46",
		"@tanstack/react-table": "^8.21.2",
		"better-auth": "^1.6.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"lucide-react": "^1.28.0",
		"radix-ui": "^1.6.7",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "2.5.7",
		"@cloudflare/vite-plugin": "^1.56.0",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@playwright/test": "1.61.1",
		"@storybook/addon-a11y": "^10.5.9",
		"@storybook/react-vite": "^10.5.9",
		"@tailwindcss/postcss": "^4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "1.0.0-rc.4",
		"happy-dom": "^20.11.1",
		"lefthook": "^1.11.3",
		"rollup-plugin-visualizer": "^7.1.1",
		"steiger": "^0.6.0",
		"storybook": "^10.5.9",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"name": "watchpoint",
	"packageManager": "bun@1.3.13",
	"private": true,
	"scripts": {
		"biome:check": "biome check --error-on-warnings .",
		"biome:fix": "biome check --write --unsafe --error-on-warnings .",
		"biome:format": "biome format --error-on-warnings .",
		"biome:lint": "biome lint --error-on-warnings .",
		"build": "bun run vite:build",
		"bundlewatch:check": "bunx bundlewatch --config bundlewatch.config.json",
		"check:cloudflare-types": "WRANGLER_LOG=warn bun run wrangler:types && test -z \"$(git status --porcelain cloudflare-env.d.ts)\"",
		"check:drizzle-schema": "bun run drizzle:generate > /dev/null && test -z \"$(git status --porcelain drizzle)\"",
		"deploy": "bun run vite:build && bun run wrangler:deploy",
		"dev": "bun run vite:dev",
		"drizzle:generate": "drizzle-kit generate",
		"playwright:e2e": "playwright test",
		"prepare": "lefthook install",
		"preview": "bun run vite:build && vite preview",
		"steiger:check": "steiger ./src",
		"storybook:build": "storybook build",
		"storybook:check:browser": "playwright test --config=storybook-a11y.config.ts",
		"storybook:dev": "storybook dev -p 6006",
		"test": "bun run vitest:unit",
		"typescript:check": "tsc --noEmit",
		"validate:fast": "bun run biome:check && bun run steiger:check && bun run typescript:check && bun run vitest:unit --reporter minimal",
		"validate:full": "bun run biome:check && bun run steiger:check && bun run typescript:check && bun run check:drizzle-schema && bun run vite:build --logLevel warn && bun run check:cloudflare-types && WRANGLER_LOG=warn bun run wrangler:deploy --dry-run && bun run vitest:coverage --reporter minimal --coverage.reporter text-summary",
		"vite:build": "vite build",
		"vite:dev": "vite dev",
		"vitest:coverage": "vitest run --coverage",
		"vitest:unit": "vitest run",
		"wrangler:deploy": "wrangler deploy",
		"wrangler:migrate": "wrangler d1 migrations apply DB",
		"wrangler:types": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false --env-file .env.example"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"type": "module",
	"version": "0.1.0"
}
